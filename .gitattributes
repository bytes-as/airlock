# Normalise to LF in the repo. This is not cosmetic: shell scripts and
# entrypoints with CRLF endings fail inside Linux containers with an opaque
# "no such file or directory" pointing at an interpreter that plainly exists.
* text=auto eol=lf

*.sh    text eol=lf
*.go    text eol=lf
*.tf    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile* text eol=lf
Makefile    text eol=lf

# Binary
*.png binary
*.pdf binary
*.mp4 binary
