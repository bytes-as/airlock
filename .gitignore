# Private working notes — never submit
_private/

# Go
/bin/
/dist/
*.exe
*.test
*.out

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/

# VS Code: share the project-level config, keep per-user state out.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Claude Code local session state
.claude/

# Local Go build scratch (Windows Application Control blocks exec from system temp)
.gotmp/
.gobin/
