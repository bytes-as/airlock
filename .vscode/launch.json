{
  "version": "0.2.0",
  "configurations": [
    {
      // Run the control plane under the debugger with the zero-dependency
      // driver, so breakpoints work without Docker in the loop.
      "name": "Debug: control plane (process driver)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/airlockd",
      "args": ["--data-dir", "${workspaceFolder}/data", "--log-level", "debug"]
    },
    {
      "name": "Debug: control plane (docker driver)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/airlockd",
      "args": [
        "--data-dir", "${workspaceFolder}/data",
        "--driver", "docker",
        "--log-level", "debug"
      ]
    },
    {
      "name": "Debug: agent",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/airlock-agent",
      "env": { "AIRLOCK_ARTIFACT_DIR": "${workspaceFolder}/data/agent-out" }
    },
    {
      // Attaches to whichever test the cursor is in.
      "name": "Debug: current test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    }
  ]
}
